{
  "schema_version": 2,
  "version": "2.1.0",
  "tools": [
    {
      "id": "git",
      "binary": "git",
      "minimum": "2.30",
      "category": "core",
      "mac_brew": "git",
      "linux_apt": "git",
      "linux_dnf": "git",
      "install": "host-manual"
    },
    {
      "id": "python",
      "binary": "python3",
      "minimum": "3.11",
      "category": "core",
      "mac_brew": "python@3.13",
      "linux_apt": "python3",
      "linux_dnf": "python3",
      "install": "host-manual"
    },
    {
      "id": "node",
      "binary": "node",
      "minimum": "20",
      "category": "core",
      "mac_brew": "node",
      "linux_apt": "nodejs",
      "linux_dnf": "nodejs",
      "install": "host-manual"
    },
    {
      "id": "npm",
      "binary": "npm",
      "category": "core",
      "mac_brew": "node",
      "linux_apt": "npm",
      "linux_dnf": "npm",
      "install": "host-manual"
    },
    {
      "id": "npx",
      "binary": "npx",
      "category": "core",
      "mac_brew": "node",
      "linux_apt": "npm",
      "linux_dnf": "npm",
      "install": "host-manual"
    },
    {
      "id": "codex",
      "binary": "codex",
      "category": "core",
      "install": "host-manual"
    },
    {
      "id": "docker",
      "binary": "docker",
      "category": "runtime",
      "mac_brew": null,
      "linux_apt": "docker.io",
      "linux_dnf": "moby-engine",
      "mac_cask": "orbstack",
      "install": "host-manual"
    },
    {
      "id": "uv",
      "binary": "uv",
      "category": "recommended",
      "mac_brew": "uv",
      "linux_apt": null,
      "linux_dnf": null,
      "install": "local-python",
      "package": "uv"
    },
    {
      "id": "playwright-cli",
      "binary": "playwright-cli",
      "category": "recommended",
      "install": "local-npm",
      "package": "@playwright/cli"
    },
    {
      "id": "gh",
      "binary": "gh",
      "category": "optional",
      "mac_brew": "gh",
      "linux_apt": "gh",
      "linux_dnf": "gh",
      "install": "host-manual"
    },
    {
      "id": "ruff",
      "binary": "ruff",
      "category": "recommended",
      "mac_brew": "ruff",
      "install": "local-python",
      "package": "ruff"
    },
    {
      "id": "skills-cli",
      "binary": "skills",
      "install": "local-npm",
      "package": "skills",
      "category": "internal"
    },
    {
      "id": "impeccable-cli",
      "binary": "impeccable",
      "install": "local-npm",
      "package": "impeccable",
      "category": "internal"
    },
    {
      "id": "rich",
      "binary": "rich",
      "install": "bundled-python-lib",
      "category": "internal",
      "note": "Bundled with installer; already available without network or global installation"
    }
  ],
