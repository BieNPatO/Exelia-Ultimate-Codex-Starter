# LOCAL DEVELOPMENT ONLY. Copy to infrastructure/.env (ignored); set reviewed digests.
# Digest values are 64 hexadecimal characters, without the sha256: prefix.
# Select compatible images and verify non-root UID/GID, volume ownership and healthchecks.
POSTGRES_DIGEST=
REDIS_DIGEST=
MAILPIT_DIGEST=
MINIO_DIGEST=
POSTGRES_DB=app_dev
POSTGRES_USER=app_user
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
REDIS_PORT=56379
MAILPIT_SMTP_PORT=51025
MAILPIT_UI_PORT=58025
MINIO_ROOT_USER=app_dev_user
MINIO_ROOT_PASSWORD=
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
